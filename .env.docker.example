MYSQL_ROOT_PASSWORD=123456
JWT_SECRET=local-demo-jwt-secret-key-change-before-production-2026-at-least-64-bytes-long

# demo works without a model key. Use live to connect a real model.
AGENT_MODE=demo
OPENAI_API_KEY=
