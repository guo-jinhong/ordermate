# Local demo defaults. Copy this file to .env only when you want to customize.
MYSQL_ROOT_PASSWORD=123456
JWT_SECRET=local-demo-jwt-secret-key-change-before-production-2026-at-least-64-bytes-long
BACKEND_HOST_PORT=8080
AGENT_HOST_PORT=8000

# demo works without a model key. Use live to connect a real model.
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=

# Optional: use a Redis instance reachable from the Agent container.
REDIS_URL=
