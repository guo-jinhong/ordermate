{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Chat QPS",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(agent_chat_requests_total[1m]))",
          "legendFormat": "total"
        },
        {
          "expr": "sum(rate(agent_chat_requests_total{status=\"error\"}[1m]))",
          "legendFormat": "error"
        }
      ],
      "yaxes": [{"format": "short"}, {"format": "short"}]
    },
    {
      "title": "Chat Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(agent_chat_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_chat_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(agent_chat_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "yaxes": [{"format": "s"}, {"format": "s"}]
    },
    {
      "title": "LLM Failure Rate",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(agent_llm_calls_total{outcome!=\"success\"}[5m])) / sum(rate(agent_llm_calls_total[5m]))",
          "legendFormat": "failure_rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 0.05, "color": "yellow"}, {"value": 0.2, "color": "red"}]}
        }
      }
    },
    {
      "title": "LLM Latency (p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_llm_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "yaxes": [{"format": "s"}, {"format": "s"}]
    },
    {
      "title": "Tool Calls by Tool",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(agent_tool_calls_total[5m])) by (tool_name)",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "title": "Knowledge Base Hit Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(agent_kb_hit_total[5m])) / sum(rate(agent_kb_search_total[5m]))",
          "legendFormat": "hit_rate"
        }
      ],
      "yaxes": [{"format": "percentunit"}, {"format": "short"}]
    },
    {
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "agent_active_sessions",
          "legendFormat": "active"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["ecommerce-agent"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "E-Commerce Agent Service",
  "uid": "ecommerce-agent-dashboard",
  "version": 1
}
