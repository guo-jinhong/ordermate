# ============================================================
# 电商客服 Agent 环境变量配置示例
# 复制此文件为 .env 并修改配置
# ============================================================

# ============ AI 模型配置 ============
# DeepSeek / OpenAI-compatible API Key（用于 live 模式）
OPENAI_API_KEY=your-api-key-here
# 模型名称
OPENAI_MODEL=deepseek-v4-flash
# API Base URL
OPENAI_BASE_URL=https://api.deepseek.com

# ============ Agent 模式 ============
# auto: 有 API Key 用 live，否则用 demo
# live: 使用 AI 模型
# demo: 使用本地规则引擎
AGENT_MODE=live

# ============ 数据库配置 ============
# 数据库类型: sqlite / mysql
DB_TYPE=mysql
# SQLite 文件路径（当 DB_TYPE=sqlite 时使用）
SQLITE_PATH=agent_service_dev.db
# MySQL 配置（当 DB_TYPE=mysql 时使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent_user
MYSQL_PASSWORD=agent_readonly_123456
MYSQL_DATABASE=ecommerce_db

# ============ 电商后端配置 ============
# 后端模式: database / api
# database: Agent 直接操作数据库（适合独立演示库）
# api: 调用 Spring Boot 后端，后端再访问 MySQL（推荐，与主系统数据一致）
ECOMMERCE_BACKEND=api

# ============ Redis 配置（可选） ============
# 不配置则使用内存存储
# REDIS_URL=redis://127.0.0.1:6379

# ============ 对话配置 ============
# 最大历史消息数
CONVERSATION_MAX_MESSAGES=12
# 对话上下文保留时间（秒）
CONVERSATION_TTL_SECONDS=1800

# ============ 请求配置 ============
# 请求超时时间（秒）
REQUEST_TIMEOUT_SECONDS=15
# 最大工具调用轮数
MAX_TOOL_ROUNDS=5

# ============ 外部 API 配置（当 ECOMMERCE_BACKEND=api 时使用） ============
ECOMMERCE_API_BASE_URL=http://localhost:8080/api

# ============ 调试配置 ============
# SQL 日志开关
SQL_ECHO=false
